<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GameDraw_App.RecordingLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" RowSpacing="16" SizeChanged="Root_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Click="Back_Click"
                Content="&#xE72B;"
                FontFamily="Segoe Fluent Icons"
                Padding="11,9"
                VerticalAlignment="Center"
                AutomationProperties.Name="그리기 작업으로 돌아가기" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="영상 기록" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" />
                <TextBlock x:Name="LibrarySummary" Text="자동 그리기 과정과 완성 결과를 한곳에서 관리합니다." Style="{ThemeResource MutedTextBlockStyle}" />
            </StackPanel>
            <Button Grid.Column="2" Click="OpenFolder_Click" Content="저장 폴더" Padding="14,8" />
            <Button Grid.Column="3" Click="Refresh_Click" Content="새로고침" Padding="14,8" />
        </Grid>

        <Grid x:Name="LibraryBody" Grid.Row="1" ColumnSpacing="16" RowSpacing="16" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="PlayerCard" Style="{ThemeResource CardBorderStyle}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NowPlayingTitle" Text="재생할 기록을 선택하세요" Style="{ThemeResource SectionTitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowPlayingDetails" Text="목록에서 재생을 누르면 영상이 여기에 표시됩니다." Style="{ThemeResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="재생 속도" VerticalAlignment="Center" Style="{ThemeResource MutedTextBlockStyle}" />
                            <ComboBox x:Name="PlaybackRateBox" Width="92" SelectedIndex="1" SelectionChanged="PlaybackRateBox_SelectionChanged">
                                <ComboBoxItem Content="0.5×" Tag="0.5" />
                                <ComboBoxItem Content="1.0×" Tag="1" />
                                <ComboBoxItem Content="1.5×" Tag="1.5" />
                                <ComboBoxItem Content="2.0×" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{ThemeResource PlayerSurfaceBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
                        <Grid>
                            <StackPanel x:Name="PlayerEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE714;" FontSize="34" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="완료된 그림 영상을 선택하세요" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" />
                            </StackPanel>
                            <MediaPlayerElement
                                x:Name="PlayerElement"
                                AreTransportControlsEnabled="True"
                                Stretch="Uniform"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Background="{ThemeResource PrimarySoftBrush}" CornerRadius="10" Padding="12,9">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectionStatus" Text="완료 영상에는 마지막 캔버스 화면이 썸네일로 저장됩니다." TextWrapping="Wrap" Style="{ThemeResource MutedTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="AVI · 로컬 저장" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ListCard" Grid.Column="1" Style="{ThemeResource CardBorderStyle}" Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="저장된 기록" Style="{ThemeResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right" Background="{ThemeResource PrimarySoftBrush}" CornerRadius="10" Padding="10,5">
                            <TextBlock x:Name="RecordingCountBadge" Text="0개" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Row="1"
                        PlaceholderText="이름·모드·원본 이미지 검색"
                        TextChanged="SearchBox_TextChanged" />
                    <Grid Grid.Row="2" MinHeight="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="RecordingList" Spacing="8" Padding="0,0,5,0" />
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyLibraryState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="저장된 영상이 없습니다" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="자동 그리기를 완료하면 여기에 기록됩니다." TextAlignment="Center" TextWrapping="Wrap" Style="{ThemeResource MutedTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
