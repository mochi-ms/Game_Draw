<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F6FA" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E7EF" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#315CF6" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E8EDFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#20B67A" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF0F0" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="#152033" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#101218" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1D25" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#303543" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#8EA7FF" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#252D4B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#57D9A2" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#48252B" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB2C4" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="#F4F6FC" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#141821" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#D9101218" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#101218" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F4F6FA" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E7EF" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#315CF6" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E8EDFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#20B67A" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFF0F0" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="#152033" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F8FAFD" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StrongTextBrush}" />
    </Style>

    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="22" />
    </Style>
</ResourceDictionary>
