<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F8FA" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EEF4FF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#059669" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#B42318" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="#101828" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#111827" />
            <SolidColorBrush x:Key="RecordRowBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0F1115" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#181B21" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2B303A" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#8DB3FF" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#202C47" />
            <SolidColorBrush x:Key="AccentBrush" Color="#5DDBA7" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#402329" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FDA4AF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#A7AFBF" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#12151A" />
            <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#080A0D" />
            <SolidColorBrush x:Key="RecordRowBrush" Color="#1C2027" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#DA0F1115" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0F1115" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F8FA" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EEF4FF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#059669" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#B42318" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
            <SolidColorBrush x:Key="StrongTextBrush" Color="#101828" />
            <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="PlayerSurfaceBrush" Color="#111827" />
            <SolidColorBrush x:Key="RecordRowBrush" Color="#FCFCFD" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource StrongTextBrush}" />
    </Style>

    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
</ResourceDictionary>
