<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameDraw_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameDraw_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="{ThemeResource PageBackgroundBrush}"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="T" Modifiers="Menu" Invoked="Theme_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="StartExecution_Invoked" />
        <KeyboardAccelerator Key="F7" Invoked="PauseResume_Invoked" />
        <KeyboardAccelerator Key="F8" Invoked="StopExecution_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="StopExecution_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot">
        <Grid
            x:Name="RootLayout"
            MaxWidth="1760"
            Padding="30,22,30,28"
            HorizontalAlignment="Stretch"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="HeaderTitle"
                        Text="그리기"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StrongTextBrush}" />
                    <TextBlock
                        x:Name="HeaderSubtitle"
                        Text="이미지를 준비하고 Podiums에 안전하게 그려 보세요."
                        Style="{ThemeResource MutedTextBlockStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="HelpButton"
                        Style="{ThemeResource HeaderActionButtonStyle}"
                        Click="ShowHelp_Click"
                        Content="사용법"
                        Padding="14,8"
                        AutomationProperties.Name="사용법 보기" />
                    <Button
                        x:Name="FloatingButton"
                        Style="{ThemeResource HeaderActionButtonStyle}"
                        Click="ToggleFloating_Click"
                        Content="{x:Bind ViewModel.FloatingLabel, Mode=OneWay}"
                        Padding="14,8"
                        AutomationProperties.Name="게임 위 플로팅 전환" />
                    <Button
                        x:Name="RecordingLibraryButton"
                        Style="{ThemeResource HeaderActionButtonStyle}"
                        Click="ShowRecordingLibrary_Click"
                        Content="영상 기록"
                        Padding="14,8"
                        AutomationProperties.Name="자동 그리기 영상 기록 보기" />
                    <Button
                        x:Name="ResetButton"
                        Style="{ThemeResource HeaderActionButtonStyle}"
                        Click="ResetWorkspace_Click"
                        Content="작업 초기화"
                        Padding="14,8"
                        AutomationProperties.Name="현재 작업 중지 및 초기화" />
                    <Button
                        x:Name="AdvancedSettingsButton"
                        Style="{ThemeResource HeaderActionButtonStyle}"
                        Content="고급 설정"
                        Padding="14,8">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="340" Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="고급 설정" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                        <TextBlock
                                            Text="대부분은 기본값 그대로 사용해도 됩니다."
                                            Style="{ThemeResource MutedTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBox
                                        Header="프로필 이름"
                                        PlaceholderText="예: Podiums 화이트보드"
                                        Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            Header="처리 폭"
                                            Minimum="1"
                                            Maximum="4096"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.LogicalWidth, Mode=TwoWay}" />
                                        <NumberBox
                                            Grid.Column="1"
                                            Header="처리 높이"
                                            Minimum="1"
                                            Maximum="4096"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.LogicalHeight, Mode=TwoWay}" />
                                    </Grid>
                                    <ToggleSwitch
                                        Header="모션 줄이기"
                                        IsOn="{x:Bind ViewModel.IsReducedMotion, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Click="ImportProfile_Click"
                                            Content="프로필 가져오기"
                                            HorizontalAlignment="Stretch" />
                                        <Button
                                            Grid.Column="1"
                                            Click="ExportProfile_Click"
                                            Content="프로필 내보내기"
                                            HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="ThemeButton"
                        Style="{ThemeResource HeaderActionButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        Content="☼"
                        Padding="12,8"
                        AutomationProperties.Name="테마 변경"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ThemeLabel, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Border
                x:Name="StatusBanner"
                Grid.Row="1"
                Background="{ThemeResource PrimarySoftBrush}"
                CornerRadius="18"
                Padding="18,12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="&#xE946;"
                        FontSize="16"
                        Foreground="{ThemeResource PrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StrongTextBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="2"
                        Click="StartDrawing_Click"
                        Content="{x:Bind ViewModel.StageLabel, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                        Padding="14,7"
                        FontWeight="SemiBold"
                        AutomationProperties.Name="바로 그리기 시작" />
                </Grid>
            </Border>

            <Grid
                x:Name="WorkspaceLayout"
                Grid.Row="2"
                MinHeight="0"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="StepRail"
                    Grid.Column="0"
                    Style="{ThemeResource CardBorderStyle}"
                    Padding="18">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="빠른 사용 순서" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="StepRailHint"
                                Text="위에서 아래로 한 번씩 진행하면 됩니다."
                                TextWrapping="Wrap"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                            <Button
                                Click="QuickStep_Click"
                                Content="1  게임 연결 · 펜 측정"
                                Tag="먼저 캔버스와 도구·HEX 위치를 저장하고, 빈 영역의 점으로 실제 펜 굵기를 측정합니다."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,9" />
                            <Button
                                Click="QuickStep_Click"
                                Content="2  이미지 선택"
                                Tag="원본 비율을 유지한 채 PNG·JPG·WEBP·BMP 사진을 불러옵니다."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,9" />
                            <Button
                                Click="QuickStep_Click"
                                Content="3  이미지 분석"
                                Tag="측정된 펜 지름과 선택한 품질을 기준으로 실제 색상과 안전 실행 경로를 계산합니다."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,9" />
                            <Button
                                Click="QuickStep_Click"
                                Content="4  그리기 시작"
                                Tag="F5로 시작하고 F7로 일시정지·재개합니다. 문제가 생기면 F8로 즉시 마우스를 놓고 중지합니다."
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,9" />
                            <Border
                                x:Name="QuickStepDetail"
                                Background="{ThemeResource PrimarySoftBrush}"
                                CornerRadius="12"
                                Padding="12,10">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="QuickStepDetailTransform" />
                                </Border.RenderTransform>
                                <TextBlock
                                    x:Name="QuickStepDetailText"
                                    Text="버튼을 누르면 단계별 설명이 여기에 표시됩니다."
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                        <Border
                            x:Name="SafetyHint"
                            Grid.Row="2"
                            Background="{ThemeResource DangerSoftBrush}"
                            CornerRadius="12"
                            Padding="12,10">
                            <TextBlock
                                Text="문제가 생기면 언제든 F8을 누르세요. 마우스를 즉시 놓고 중지합니다."
                                TextWrapping="Wrap"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="PreviewCard"
                    Grid.Column="1"
                    Style="{ThemeResource CardBorderStyle}"
                    Padding="18">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="그림 미리보기" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="PreviewDescription"
                                    Text="분석 후 실제로 그릴 색상 결과를 바로 확인할 수 있습니다."
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Border
                                x:Name="PreviewBadge"
                                Grid.Column="1"
                                Background="{ThemeResource PreviewSurfaceBrush}"
                                CornerRadius="10"
                                Padding="10,6">
                                <TextBlock
                                    x:Name="PreviewBadgeLabel"
                                    Text="원본"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </Border>
                        </Grid>

                        <Border
                            x:Name="PreviewSurface"
                            Grid.Row="1"
                            MinHeight="0"
                            Background="{ThemeResource PreviewSurfaceBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                        CornerRadius="20"
                            Padding="16">
                            <Grid>
                                <StackPanel
                                    x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE8B9;"
                                        FontSize="38"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource PrimaryBrush}" />
                                    <TextBlock
                                        Text="이미지를 놓거나 아래 버튼으로 선택하세요"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock
                                        Text="PNG · JPG · WEBP · BMP"
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                                <Image
                                    x:Name="PreviewImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SelectImageButton"
                                Click="SelectImage_Click"
                                Content="1  이미지 선택"
                                IsEnabled="{x:Bind ViewModel.CanChangeImage, Mode=OneWay}"
                                Padding="16,9" />
                            <StackPanel Grid.Column="1" Margin="2,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StrongTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="FileHint"
                                    Text="드래그 앤 드롭 가능"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ClearImageCommand}"
                                Content="지우기"
                                IsEnabled="{x:Bind ViewModel.CanClearImage, Mode=OneWay}"
                                Padding="12,9" />
                        </Grid>
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Column="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                <Grid
                    x:Name="ControlPanel"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{ThemeResource CardBorderStyle}" Padding="18,15">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="1">
                            <TextBlock Text="1  Podiums 연결 · 펜 측정" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ProfileStatusLabel, Mode=OneWay}"
                                    Foreground="{ThemeResource PrimaryBrush}"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox
                                    Header="캔버스 비율"
                                    SelectedItem="{x:Bind ViewModel.SelectedCanvasAspect, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>자유 비율</x:String>
                                    <x:String>1:1 정사각형</x:String>
                                    <x:String>4:3 가로형</x:String>
                                    <x:String>16:9 가로형</x:String>
                                    <x:String>원본 이미지 비율</x:String>
                                </ComboBox>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Click="ProfileSetup_Click"
                                    Content="영역 드래그"
                                    Padding="14,8" />
                                <Button
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Click="ToolSetup_Click"
                                    Content="도구 · HEX 위치 설정 (F6)"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8" />
                                <Button
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Click="HexOnlySetup_Click"
                                    Content="HEX 입력칸만 다시 설정 (F6)"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8" />
                                <Button
                                    Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Click="HexTest_Click"
                                    Content="HEX #FF3B82 작동 테스트"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,8" />
                            </Grid>
                            <Button
                                Click="BrushMeasure_Click"
                                Content="빈 영역 선택 → 현재 펜 굵기 자동 측정"
                                HorizontalAlignment="Stretch"
                                Padding="14,9" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    Header="게임에 표시된 펜 굵기"
                                    Value="{x:Bind ViewModel.ManualBrushDiameter, Mode=TwoWay}"
                                    Minimum="1"
                                    Maximum="32"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact" />
                                <Button
                                    Grid.Column="1"
                                    Click="ManualBrushApply_Click"
                                    Content="직접 보정 적용"
                                    VerticalAlignment="Bottom"
                                    Padding="14,8" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ViewModel.BrushStatusLabel, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource PrimaryBrush}" />
                            <TextBlock
                                x:Name="CalibrationHint"
                                Text="영역은 박스로 드래그합니다. 펜 굵기는 게임에서 수동 설정하며 프로그램은 건드리지 않습니다."
                                TextWrapping="Wrap"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{ThemeResource CardBorderStyle}" Padding="18,15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="2  분석 설정" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <Grid ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox Header="표현 방식" SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:String>AI 밑그림·안전 채색</x:String>
                                    <x:String>AI 흑백 사진</x:String>
                                    <x:String>원본 팔레트 256색</x:String>
                                    <x:String>작가식 정밀 선화</x:String>
                                    <x:String>고품질 망점 사진</x:String>
                                </ComboBox>
                                <ComboBox Grid.Column="1" Header="그림 품질" SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:String>속도 우선</x:String>
                                    <x:String>추천</x:String>
                                    <x:String>정밀</x:String>
                                    <x:String>최고 정밀</x:String>
                                </ComboBox>
                                <ComboBox Grid.Row="1" Header="실행 속도" SelectedItem="{x:Bind ViewModel.SelectedSpeed, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:String>안전 확인</x:String>
                                    <x:String>고속 점묘</x:String>
                                    <x:String>최대 속도</x:String>
                                </ComboBox>
                                <NumberBox Grid.Row="1" Grid.Column="1" Header="최대 색상 (2~256)" Value="{x:Bind ViewModel.MaximumColors, Mode=TwoWay}" Minimum="2" Maximum="256" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    Header="스마트 피사체"
                                    OffContent="원본 유지"
                                    OnContent="배경 제거 · 인물 우선"
                                    IsOn="{x:Bind ViewModel.SmartSubjectEnabled, Mode=TwoWay}"
                                    ToolTipService.ToolTip="로컬 분석으로 배경을 지우고 인물 구도에서는 얼굴 특징부터 그립니다." />
                                <Button
                                    Grid.Column="1"
                                    Click="ManualCrop_Click"
                                    Content="직접 자르기"
                                    IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                    VerticalAlignment="Bottom"
                                    Padding="14,8" />
                            </Grid>
                            <TextBlock
                                x:Name="CropStatusText"
                                Text="직접 자르기를 사용하면 선택한 영역 안에서 배경을 다시 분석합니다."
                                Style="{ThemeResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <StackPanel x:Name="AnalysisDescriptionPanel" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SpeedDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.QualityDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                Click="PrepareDrawing_Click"
                                Content="2  이미지 분석"
                                IsEnabled="{x:Bind ViewModel.CanPrepare, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Padding="16,10" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{ThemeResource CardBorderStyle}" Padding="18,15">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="4  실행" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                                    Foreground="{ThemeResource PrimaryBrush}"
                                    FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar
                                x:Name="ProgressBar"
                                Grid.Row="1"
                                Maximum="1"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="2"
                                Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="2"
                                VerticalAlignment="Center"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                            <Button
                                Grid.Row="3"
                                Click="StartDrawing_Click"
                                Content="F5 · Podiums에 그리기 시작"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Padding="16,12"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Grid>

            <local:RecordingLibraryView
                x:Name="RecordingLibraryPage"
                Grid.Row="2"
                MinHeight="0"
                Visibility="Collapsed" />
        </Grid>

        <Grid
            x:Name="FloatingLayout"
            Padding="12,10,12,12"
            RowSpacing="8"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource PlayerSurfaceBrush}" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Stretch="UniformToFill" />
                </Border>
                <TextBlock Grid.Column="1" Text="GameDraw" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Click="ShowHelp_Click" Content="?" Padding="10,7" AutomationProperties.Name="사용법 보기" />
                <Button Grid.Column="3" Click="ResetWorkspace_Click" Content="초기화" Padding="10,7" />
                <Button Grid.Column="4" Click="ToggleFloating_Click" Content="크게" Padding="10,7" />
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource PrimarySoftBrush}" CornerRadius="12" Padding="12,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                        Foreground="{ThemeResource PrimaryBrush}"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TabView
                Grid.Row="2"
                IsAddTabButtonVisible="False">
                <TabViewItem Header="이미지" IsClosable="False">
                    <Border Style="{ThemeResource CardBorderStyle}" Padding="14">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource PreviewSurfaceBrush}" CornerRadius="12" Padding="0" Visibility="Collapsed">
                                <Image x:Name="FloatingPreviewImage" Stretch="Uniform" />
                            </Border>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="SelectImage_Click" Content="선택" Padding="10,7" />
                            </Grid>
                            <Border Grid.Row="2" Background="{ThemeResource PrimarySoftBrush}" CornerRadius="12" Padding="12,9">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedMode, Mode=OneWay}" FontWeight="SemiBold" />
                                    <TextBlock Text="표현 방식과 품질은 아래에서 바로 바꿀 수 있습니다." Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:String>AI 밑그림·안전 채색</x:String><x:String>AI 흑백 사진</x:String><x:String>원본 팔레트 256색</x:String><x:String>작가식 정밀 선화</x:String><x:String>고품질 망점 사진</x:String>
                                </ComboBox>
                                <ComboBox Grid.Column="1" SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                    <x:String>속도 우선</x:String><x:String>추천</x:String><x:String>정밀</x:String><x:String>최고 정밀</x:String>
                                </ComboBox>
                            </Grid>
                            <StackPanel Grid.Row="4" Spacing="4">
                                <ToggleSwitch
                                    Header="스마트 피사체"
                                    OffContent="끔"
                                    OnContent="배경 제거 · 인물 우선"
                                    IsOn="{x:Bind ViewModel.SmartSubjectEnabled, Mode=TwoWay}" />
                                <Button Click="ManualCrop_Click" Content="직접 자르기" IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button Grid.Row="5" Click="PrepareDrawing_Click" Content="이미지 분석" IsEnabled="{x:Bind ViewModel.CanPrepare, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="14,9" />
                        </Grid>
                    </Border>
                </TabViewItem>

                <TabViewItem Header="연결" IsClosable="False">
                    <Border Style="{ThemeResource CardBorderStyle}" Padding="16">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Podiums 캔버스 연결" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ProfileStatusLabel, Mode=OneWay}" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                            <ComboBox Header="캔버스 비율" SelectedItem="{x:Bind ViewModel.SelectedCanvasAspect, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <x:String>자유 비율</x:String>
                                <x:String>1:1 정사각형</x:String>
                                <x:String>4:3 가로형</x:String>
                                <x:String>16:9 가로형</x:String>
                                <x:String>원본 이미지 비율</x:String>
                            </ComboBox>
                            <Button Click="ProfileSetup_Click" Content="캔버스 영역 드래그" HorizontalAlignment="Stretch" Padding="12,10" />
                            <Button Click="ToolSetup_Click" Content="도구 · HEX 위치 설정 (F6)" HorizontalAlignment="Stretch" Padding="12,10" />
                            <Button Click="HexOnlySetup_Click" Content="HEX 입력칸만 다시 설정 (F6)" HorizontalAlignment="Stretch" Padding="12,10" />
                            <Button Click="HexTest_Click" Content="HEX #FF3B82 작동 테스트" HorizontalAlignment="Stretch" Padding="12,10" />
                            <Button Click="BrushMeasure_Click" Content="빈 영역 선택 → 현재 펜 굵기 자동 측정" HorizontalAlignment="Stretch" Padding="12,10" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox Header="게임 펜 굵기" Value="{x:Bind ViewModel.ManualBrushDiameter, Mode=TwoWay}" Minimum="1" Maximum="32" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                <Button Grid.Column="1" Click="ManualBrushApply_Click" Content="직접 적용" VerticalAlignment="Bottom" Padding="12,8" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.BrushStatusLabel, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource PrimaryBrush}" />
                            <TextBlock Text="색상 모드는 HEX 입력란 더블클릭 → Ctrl+A → 붙여넣기 → Ctrl+C 읽기 검증 → Enter 순서로 확정합니다." TextWrapping="Wrap" Style="{ThemeResource MutedTextBlockStyle}" />
                            <Border Padding="12" Background="{ThemeResource PreviewSurfaceBrush}" CornerRadius="12">
                                <TextBlock Text="캔버스를 지정한 뒤 이미지 탭에서 분석하고, 실행 탭에서 시작하세요. 실행 시 GameDraw는 자동으로 숨겨집니다." TextWrapping="Wrap" Style="{ThemeResource MutedTextBlockStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </TabViewItem>

                <TabViewItem Header="실행" IsClosable="False">
                    <Border Style="{ThemeResource CardBorderStyle}" Padding="16">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="자동 그리기 실행" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar Grid.Row="1" Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{ThemeResource MutedTextBlockStyle}" />
                            <Button Grid.Row="3" Click="StartDrawing_Click" Content="F5 · Podiums에 그리기 시작" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" HorizontalAlignment="Stretch" Padding="14,12" Style="{StaticResource AccentButtonStyle}" />
                            <Button Grid.Row="4" Click="ResetWorkspace_Click" Content="중지하고 새 작업으로 초기화" HorizontalAlignment="Stretch" Padding="14,10" />
                        </Grid>
                    </Border>
                </TabViewItem>
            </TabView>
        </Grid>

        <Grid
            x:Name="BusyOverlay"
            Canvas.ZIndex="20"
            Background="{ThemeResource OverlayBrush}"
            Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Border
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel Width="300" HorizontalAlignment="Center" Spacing="12">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="36"
                        Height="36" />
                    <TextBlock
                        Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource StrongTextBrush}" />
                    <TextBlock
                        Text="분석은 백그라운드에서 실행되며 앱은 계속 반응합니다."
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Style="{ThemeResource MutedTextBlockStyle}" />
                    <Button
                        Click="CancelWork_Click"
                        Content="작업 취소"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
