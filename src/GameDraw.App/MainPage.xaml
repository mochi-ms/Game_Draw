<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameDraw_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameDraw_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="{ThemeResource PageBackgroundBrush}"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="T" Modifiers="Menu" Invoked="Theme_Invoked" />
        <KeyboardAccelerator Key="F7" Invoked="PauseResume_Invoked" />
        <KeyboardAccelerator Key="F8" Invoked="StopExecution_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="StopExecution_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot">
        <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="RootLayout"
            MaxWidth="1440"
            Padding="32,28,32,36"
            HorizontalAlignment="Center"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="GameDraw"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StrongTextBrush}" />
                    <TextBlock
                        Text="이미지를 게임 캔버스용 입력 동작으로 바꾸는 작업 공간"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        Style="{ThemeResource MutedTextBlockStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="ThemeButton"
                        Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        Content="☼"
                        Padding="12,8"
                        AutomationProperties.Name="테마 변경"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ThemeLabel, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.ToggleExecutionPanelCommand}"
                        Content="실행 패널"
                        Padding="14,8"
                        AutomationProperties.Name="실행 패널 표시" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Background="{ThemeResource PrimarySoftBrush}"
                CornerRadius="16"
                Padding="18,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="현재 작업"
                            FontSize="12"
                            Foreground="{ThemeResource MutedTextBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StrongTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14,8"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.StageLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid
                x:Name="WorkspaceLayout"
                Grid.Row="2"
                ColumnSpacing="18"
                RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="PreviewCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{ThemeResource CardBorderStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="이미지 미리보기" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="원본 비율을 유지한 채 작업 영역에 표시합니다."
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Border
                                x:Name="PreviewBadge"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Background="{ThemeResource PreviewSurfaceBrush}"
                                CornerRadius="10"
                                Padding="10,6">
                                <TextBlock
                                    x:Name="PreviewBadgeLabel"
                                    Text="원본 미리보기"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </Border>
                        </Grid>

                        <Border
                            x:Name="PreviewSurface"
                            Grid.Row="1"
                            Background="{ThemeResource PreviewSurfaceBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            MinHeight="360"
                            Padding="24">
                            <Grid>
                                <StackPanel
                                    x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                                    <FontIcon
                                        Glyph="&#xE8B9;"
                                        FontSize="42"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource PrimaryBrush}" />
                                    <TextBlock
                                        Text="이미지를 여기에 놓거나 파일을 선택하세요"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock
                                        Text="PNG, JPG, JPEG, WEBP, BMP"
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                                <Image
                                    x:Name="PreviewImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxHeight="560"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SelectImageButton"
                                Click="SelectImage_Click"
                                Content="이미지 선택"
                                IsEnabled="{x:Bind ViewModel.CanChangeImage, Mode=OneWay}"
                                Padding="18,10"
                                AutomationProperties.Name="이미지 파일 선택"
                                AutomationProperties.HelpText="그릴 이미지 파일을 선택합니다." />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StrongTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="드래그 앤 드롭도 지원합니다"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ClearImageCommand}"
                                Content="초기화"
                                IsEnabled="{x:Bind ViewModel.CanClearImage, Mode=OneWay}"
                                Padding="16,10" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="ControlPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="18">
                    <Border Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="프로필" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="게임 창과 캔버스 정보를 저장하는 단위입니다."
                                    Style="{ThemeResource MutedTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox
                                Header="프로필 이름"
                                PlaceholderText="예: Podiums 화이트보드"
                                Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}"
                                AutomationProperties.Name="프로필 이름" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ProfileStatusLabel, Mode=OneWay}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryBrush}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    Header="논리 폭"
                                    Minimum="1"
                                    Maximum="4096"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.LogicalWidth, Mode=TwoWay}" />
                                <NumberBox
                                    Grid.Column="1"
                                    Header="논리 높이"
                                    Minimum="1"
                                    Maximum="4096"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.LogicalHeight, Mode=TwoWay}" />
                            </Grid>
                            <Button
                                Click="ProfileSetup_Click"
                                Content="Podiums 캘리브레이션"
                                HorizontalAlignment="Stretch" />
                            <TextBlock
                                Text="캔버스와 연필·지우개·채우기·굵기 슬라이더·HEX 입력 위치를 F6으로 기록합니다."
                                Style="{ThemeResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <Border
                                Padding="14"
                                Background="{ThemeResource PrimarySoftBrush}"
                                CornerRadius="14"
                                Visibility="{x:Bind ViewModel.IsCalibrating, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        Text="캘리브레이션 진행 중"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource PrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CalibrationMessage, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource StrongTextBrush}" />
                                    <Button
                                        Click="CancelCalibration_Click"
                                        Content="캘리브레이션 취소"
                                        HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="그리기 모드" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="원본을 변환할 방식을 선택합니다."
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="SelectedModeComboBox"
                                Header="모드"
                                SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}"
                                AutomationProperties.Name="그리기 모드">
                                <x:String>자동 추천</x:String>
                                <x:String>픽셀 점찍기</x:String>
                                <x:String>가로 스캔라인</x:String>
                                <x:String>세로 스캔라인</x:String>
                                <x:String>윤곽선</x:String>
                                <x:String>면 채우기</x:String>
                                <x:String>하이브리드</x:String>
                            </ComboBox>
                            <TextBlock
                                Text="픽셀 점찍기와 선 기반 모드는 같은 DrawingPlan 계약으로 연결됩니다."
                                Style="{ThemeResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <NumberBox
                                Header="최대 색상 수"
                                Minimum="2"
                                Maximum="256"
                                SmallChange="8"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.MaximumColors, Mode=TwoWay}"
                                AutomationProperties.Name="최대 색상 수" />
                            <TextBlock
                                Text="128색과 디더링이 기본이며 필요하면 256색까지 선택할 수 있습니다."
                                Style="{ThemeResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="실행 상태" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.StageLabel, Mode=OneWay}"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </Grid>
                            <ProgressBar
                                x:Name="ProgressBar"
                                Maximum="1"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                AutomationProperties.Name="실행 진행률" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}"
                                Style="{ThemeResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <Button
                                Click="PrepareDrawing_Click"
                                Content="이미지 분석"
                                IsEnabled="{x:Bind ViewModel.CanPrepare, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="이미지 분석" />
                            <Button
                                Click="StartDrawing_Click"
                                Content="Podiums에 그리기 시작"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Podiums 자동 그리기 시작" />
                            <Button
                                Command="{x:Bind ViewModel.ToggleExecutionPanelCommand}"
                                Content="실행 패널 열기"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="실행 패널 열기" />
                        </StackPanel>
                    </Border>

                    <Border Style="{ThemeResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="접근성 및 표시" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <ToggleSwitch
                                Header="모션 줄이기"
                                IsOn="{x:Bind ViewModel.IsReducedMotion, Mode=TwoWay}"
                                AutomationProperties.Name="모션 줄이기" />
                            <TextBlock
                                Text="실행 중에는 Roblox 위에 별도의 상태 창이 표시되며 F7/F8로 제어합니다."
                                Style="{ThemeResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>

        <Grid
            x:Name="BusyOverlay"
            Canvas.ZIndex="20"
            Background="{ThemeResource OverlayBrush}"
            Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Border
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="로딩 중" />
                    <TextBlock
                        Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Style="{ThemeResource MutedTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            x:Name="ExecutionOverlay"
            Canvas.ZIndex="10"
            Margin="24"
            Padding="18"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MaxWidth="360"
            Background="{ThemeResource CardBackgroundBrush}"
            BorderBrush="{ThemeResource PrimaryBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="{x:Bind ViewModel.IsExecutionPanelVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="실행 패널" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            Style="{ThemeResource MutedTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                        Style="{ThemeResource MutedTextBlockStyle}" />
                </Grid>
                <ProgressBar
                    Maximum="1"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                    AutomationProperties.Name="실행 패널 진행률" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="PauseResume_Click"
                        Content="일시 정지/재개"
                        IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}"
                        AutomationProperties.Name="실행 일시 정지 또는 재개" />
                    <Button
                        Click="StopDrawing_Click"
                        Content="중지"
                        IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}"
                        AutomationProperties.Name="실행 중지" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
