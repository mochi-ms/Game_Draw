<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameDraw_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameDraw_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="{ThemeResource PageBackgroundBrush}"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="T" Modifiers="Menu" Invoked="Theme_Invoked" />
        <KeyboardAccelerator Key="F7" Invoked="PauseResume_Invoked" />
        <KeyboardAccelerator Key="F8" Invoked="StopExecution_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="StopExecution_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="PageRoot">
        <Grid
            x:Name="RootLayout"
            MaxWidth="1680"
            Padding="24,18,24,22"
            HorizontalAlignment="Stretch"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        Text="GameDraw"
                        FontSize="27"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StrongTextBrush}" />
                    <TextBlock
                        x:Name="HeaderSubtitle"
                        Text="이미지 선택부터 게임 자동 그리기까지 한 화면에서 진행하세요."
                        Style="{ThemeResource MutedTextBlockStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="HelpButton"
                        Click="ShowHelp_Click"
                        Content="사용법"
                        Padding="14,8"
                        AutomationProperties.Name="사용법 보기" />
                    <Button
                        x:Name="FloatingButton"
                        Click="ToggleFloating_Click"
                        Content="{x:Bind ViewModel.FloatingLabel, Mode=OneWay}"
                        Padding="14,8"
                        AutomationProperties.Name="게임 위 플로팅 전환" />
                    <Button
                        x:Name="AdvancedSettingsButton"
                        Content="고급 설정"
                        Padding="14,8">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="340" Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="고급 설정" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                        <TextBlock
                                            Text="대부분은 기본값 그대로 사용해도 됩니다."
                                            Style="{ThemeResource MutedTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBox
                                        Header="프로필 이름"
                                        PlaceholderText="예: Podiums 화이트보드"
                                        Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            Header="처리 폭"
                                            Minimum="1"
                                            Maximum="4096"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.LogicalWidth, Mode=TwoWay}" />
                                        <NumberBox
                                            Grid.Column="1"
                                            Header="처리 높이"
                                            Minimum="1"
                                            Maximum="4096"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind ViewModel.LogicalHeight, Mode=TwoWay}" />
                                    </Grid>
                                    <ToggleSwitch
                                        Header="모션 줄이기"
                                        IsOn="{x:Bind ViewModel.IsReducedMotion, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Click="ImportProfile_Click"
                                            Content="프로필 가져오기"
                                            HorizontalAlignment="Stretch" />
                                        <Button
                                            Grid.Column="1"
                                            Click="ExportProfile_Click"
                                            Content="프로필 내보내기"
                                            HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="ThemeButton"
                        Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        Content="☼"
                        Padding="12,8"
                        AutomationProperties.Name="테마 변경"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ThemeLabel, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Background="{ThemeResource PrimarySoftBrush}"
                CornerRadius="14"
                Padding="16,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="&#xE946;"
                        FontSize="16"
                        Foreground="{ThemeResource PrimaryBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StrongTextBrush}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <Border
                        Grid.Column="2"
                        Background="{ThemeResource CardBackgroundBrush}"
                        CornerRadius="10"
                        Padding="12,6">
                        <TextBlock
                            Text="{x:Bind ViewModel.StageLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource PrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid
                x:Name="WorkspaceLayout"
                Grid.Row="2"
                MinHeight="0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="StepRail"
                    Grid.Column="0"
                    Style="{ThemeResource CardBorderStyle}"
                    Padding="18">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="빠른 사용 순서" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="StepRailHint"
                                Text="위에서 아래로 한 번씩 진행하면 됩니다."
                                TextWrapping="Wrap"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                            <Border Background="{ThemeResource PrimarySoftBrush}" CornerRadius="12" Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="1  이미지 선택" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock Text="그릴 사진을 불러옵니다" Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource PreviewSurfaceBrush}" CornerRadius="12" Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="2  이미지 분석" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock Text="색상과 경로를 계산합니다" Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource PreviewSurfaceBrush}" CornerRadius="12" Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="3  게임 연결" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock Text="처음 한 번만 F6 보정" Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource PreviewSurfaceBrush}" CornerRadius="12" Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="4  그리기 시작" FontWeight="SemiBold" Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock Text="F7 일시정지 · F8 중지" Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border
                            x:Name="SafetyHint"
                            Grid.Row="2"
                            Background="{ThemeResource DangerSoftBrush}"
                            CornerRadius="12"
                            Padding="12,10">
                            <TextBlock
                                Text="문제가 생기면 언제든 F8을 누르세요. 마우스를 즉시 놓고 중지합니다."
                                TextWrapping="Wrap"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    x:Name="PreviewCard"
                    Grid.Column="1"
                    Style="{ThemeResource CardBorderStyle}"
                    Padding="18">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="그림 미리보기" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    x:Name="PreviewDescription"
                                    Text="분석 후 실제로 그릴 색상 결과를 바로 확인할 수 있습니다."
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Border
                                x:Name="PreviewBadge"
                                Grid.Column="1"
                                Background="{ThemeResource PreviewSurfaceBrush}"
                                CornerRadius="10"
                                Padding="10,6">
                                <TextBlock
                                    x:Name="PreviewBadgeLabel"
                                    Text="원본"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </Border>
                        </Grid>

                        <Border
                            x:Name="PreviewSurface"
                            Grid.Row="1"
                            MinHeight="0"
                            Background="{ThemeResource PreviewSurfaceBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">
                            <Grid>
                                <StackPanel
                                    x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE8B9;"
                                        FontSize="38"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource PrimaryBrush}" />
                                    <TextBlock
                                        Text="이미지를 놓거나 아래 버튼으로 선택하세요"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource StrongTextBrush}" />
                                    <TextBlock
                                        Text="PNG · JPG · WEBP · BMP"
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource MutedTextBlockStyle}" />
                                </StackPanel>
                                <Image
                                    x:Name="PreviewImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SelectImageButton"
                                Click="SelectImage_Click"
                                Content="1  이미지 선택"
                                IsEnabled="{x:Bind ViewModel.CanChangeImage, Mode=OneWay}"
                                Padding="16,9" />
                            <StackPanel Grid.Column="1" Margin="2,0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StrongTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="FileHint"
                                    Text="드래그 앤 드롭 가능"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ClearImageCommand}"
                                Content="지우기"
                                IsEnabled="{x:Bind ViewModel.CanClearImage, Mode=OneWay}"
                                Padding="12,9" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid
                    x:Name="ControlPanel"
                    Grid.Column="2"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" Style="{ThemeResource CardBorderStyle}" Padding="18,15">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock Text="3  Podiums 연결" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ProfileStatusLabel, Mode=OneWay}"
                                        Foreground="{ThemeResource PrimaryBrush}"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="FullProfileSetup_Click"
                                    Content="도구 재설정"
                                    Padding="14,8" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="캔버스 비율"
                                    SelectedItem="{x:Bind ViewModel.SelectedCanvasAspect, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>자유 비율</x:String>
                                    <x:String>1:1 정사각형</x:String>
                                    <x:String>4:3 가로형</x:String>
                                    <x:String>16:9 가로형</x:String>
                                    <x:String>원본 이미지 비율</x:String>
                                </ComboBox>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Click="ProfileSetup_Click"
                                    Content="영역 드래그"
                                    Padding="14,8" />
                            </Grid>
                            <TextBlock
                                x:Name="CalibrationHint"
                                Text="흰 캔버스는 박스로 한 번 드래그합니다. 도구 재설정은 연필·색상 위치가 바뀐 경우에만 사용하세요."
                                TextWrapping="Wrap"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                            <Border
                                Padding="12"
                                Background="{ThemeResource PrimarySoftBrush}"
                                CornerRadius="12"
                                Visibility="{x:Bind ViewModel.IsCalibrating, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CalibrationMessage, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource StrongTextBrush}" />
                                    <Button Grid.Column="1" Click="CancelCalibration_Click" Content="취소" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Style="{ThemeResource CardBorderStyle}" Padding="18,15">
                        <StackPanel Spacing="10">
                            <TextBlock Text="2  분석 설정" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="표현 방식"
                                    SelectedItem="{x:Bind ViewModel.SelectedRenderStyle, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>자동 채색</x:String>
                                    <x:String>검정 선화</x:String>
                                </ComboBox>
                                <ComboBox
                                    Grid.Column="1"
                                    Header="실행 속도"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpeed, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>안전하게</x:String>
                                    <x:String>빠르게</x:String>
                                    <x:String>매우 빠르게</x:String>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SelectedModeComboBox"
                                    Header="그리는 방법"
                                    SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch">
                                    <x:String>자동 추천</x:String>
                                    <x:String>픽셀 점찍기</x:String>
                                    <x:String>가로 스캔라인</x:String>
                                    <x:String>세로 스캔라인</x:String>
                                    <x:String>윤곽선</x:String>
                                    <x:String>면 채우기</x:String>
                                    <x:String>하이브리드</x:String>
                                </ComboBox>
                                <NumberBox
                                    Grid.Column="1"
                                    Header="최대 색상"
                                    Minimum="2"
                                    Maximum="256"
                                    SmallChange="8"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.MaximumColors, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel x:Name="AnalysisDescriptionPanel" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind ViewModel.RenderStyleDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ModeDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SpeedDescription, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{ThemeResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                Click="PrepareDrawing_Click"
                                Content="2  이미지 분석"
                                IsEnabled="{x:Bind ViewModel.CanPrepare, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Padding="16,10" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{ThemeResource CardBorderStyle}" Padding="18,15">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="4  실행" Style="{ThemeResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}"
                                    Foreground="{ThemeResource PrimaryBrush}"
                                    FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar
                                x:Name="ProgressBar"
                                Grid.Row="1"
                                Maximum="1"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="2"
                                Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Style="{ThemeResource MutedTextBlockStyle}" />
                            <Button
                                Grid.Row="3"
                                Click="StartDrawing_Click"
                                Content="4  Podiums에 그리기 시작"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                Padding="16,12"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid
            x:Name="BusyOverlay"
            Canvas.ZIndex="20"
            Background="{ThemeResource OverlayBrush}"
            Visibility="{x:Bind ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
            <Border
                Padding="26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel Width="300" HorizontalAlignment="Center" Spacing="12">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="36"
                        Height="36" />
                    <TextBlock
                        Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource StrongTextBrush}" />
                    <TextBlock
                        Text="분석은 백그라운드에서 실행되며 앱은 계속 반응합니다."
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Style="{ThemeResource MutedTextBlockStyle}" />
                    <Button
                        Click="CancelWork_Click"
                        Content="작업 취소"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
