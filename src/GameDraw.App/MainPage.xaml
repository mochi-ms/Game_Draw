<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameDraw_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameDraw_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="{StaticResource PageBackgroundBrush}"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="RootLayout"
            MaxWidth="1440"
            Padding="32,28,32,36"
            HorizontalAlignment="Center"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="GameDraw"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource StrongTextBrush}" />
                    <TextBlock
                        Text="이미지를 게임 캔버스용 입력 동작으로 바꾸는 작업 공간"
                        Style="{StaticResource MutedTextBlockStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="도움말"
                    IsEnabled="False"
                    Padding="18,10"
                    VerticalAlignment="Center" />
            </Grid>

            <Border
                Grid.Row="1"
                Background="{StaticResource PrimarySoftBrush}"
                CornerRadius="16"
                Padding="18,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="현재 작업"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource StrongTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14,8"
                        VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.StageLabel, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Grid
                x:Name="WorkspaceLayout"
                Grid.Row="2"
                ColumnSpacing="18"
                RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="PreviewCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Spacing="3">
                                <TextBlock Text="이미지 미리보기" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="원본 비율을 유지한 채 작업 영역에 표시합니다."
                                    Style="{StaticResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Border
                                HorizontalAlignment="Right"
                                Background="{StaticResource PreviewSurfaceBrush}"
                                CornerRadius="10"
                                Padding="10,6">
                                <TextBlock Text="원본 미리보기" Style="{StaticResource MutedTextBlockStyle}" />
                            </Border>
                        </Grid>

                        <Border
                            x:Name="PreviewSurface"
                            Grid.Row="1"
                            Background="{StaticResource PreviewSurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            MinHeight="360"
                            Padding="24">
                            <Grid>
                                <StackPanel
                                    x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                                    <FontIcon
                                        Glyph="&#xE8B9;"
                                        FontSize="42"
                                        HorizontalAlignment="Center"
                                        Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock
                                        Text="이미지를 여기에 놓거나 파일을 선택하세요"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        Foreground="{StaticResource StrongTextBrush}" />
                                    <TextBlock
                                        Text="PNG, JPG, JPEG, WEBP, BMP"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource MutedTextBlockStyle}" />
                                </StackPanel>
                                <Image
                                    x:Name="PreviewImage"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxHeight="560"
                                    Stretch="Uniform"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SelectImageButton"
                                Click="SelectImage_Click"
                                Content="이미지 선택"
                                Padding="18,10" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedImageName, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource StrongTextBrush}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="드래그 앤 드롭도 지원합니다"
                                    Style="{StaticResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ClearImageCommand}"
                                Content="초기화"
                                IsEnabled="{x:Bind ViewModel.HasImage, Mode=OneWay}"
                                Padding="16,10" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="ControlPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Spacing="18">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="프로필" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="게임 창과 캔버스 정보를 저장하는 단위입니다."
                                    Style="{StaticResource MutedTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox
                                Header="프로필 이름"
                                PlaceholderText="예: Podiums 화이트보드"
                                Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay}" />
                            <Button Content="프로필 설정" IsEnabled="False" HorizontalAlignment="Stretch" />
                            <TextBlock
                                Text="1단계에서는 기본 셸만 제공하며, 캘리브레이션은 다음 단계에서 연결됩니다."
                                Style="{StaticResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="그리기 모드" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    Text="원본을 변환할 방식을 선택합니다."
                                    Style="{StaticResource MutedTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="SelectedModeComboBox"
                                Header="모드"
                                SelectedItem="{x:Bind ViewModel.SelectedMode, Mode=TwoWay}">
                                <x:String>자동 추천</x:String>
                                <x:String>픽셀 점찍기</x:String>
                                <x:String>가로 스캔라인</x:String>
                                <x:String>세로 스캔라인</x:String>
                                <x:String>윤곽선</x:String>
                                <x:String>면 채우기</x:String>
                                <x:String>하이브리드</x:String>
                            </ComboBox>
                            <TextBlock
                                Text="픽셀 점찍기와 선 기반 모드는 같은 DrawingPlan 계약으로 연결됩니다."
                                Style="{StaticResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <TextBlock Text="실행 상태" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="준비 중"
                                    Style="{StaticResource MutedTextBlockStyle}" />
                            </Grid>
                            <ProgressBar
                                x:Name="ProgressBar"
                                Maximum="1"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                            <TextBlock
                                Text="이미지를 선택하고 프로필을 캘리브레이션하면 실행할 수 있습니다."
                                Style="{StaticResource MutedTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <Button Content="실행" IsEnabled="False" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
