<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameDraw_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:GameDraw_App.ViewModels"
    AllowDrop="True"
    Background="{StaticResource PageBackgroundBrush}"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged"
    mc:Ignorable="d">

    <ScrollViewer x:Name="PageScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" MaxWidth="1520" Padding="32,24,32,36" HorizontalAlignment="Stretch" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="GameDraw" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="이미지를 게임 그림으로 바꿔보세요" FontSize="30" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap" />
                    <TextBlock Text="이미지를 넣고, 한 번 설정한 뒤, 화면에 안전하게 그립니다." Style="{StaticResource MutedTextStyle}" FontSize="14" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Content="사용 방법"
                    Style="{StaticResource TextButtonStyle}"
                    Click="Help_Click"
                    VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource AccentSubtleBrush}" BorderBrush="#C9D6FF" BorderThickness="1" CornerRadius="10" Padding="14,11">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#172033" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid x:Name="MainLayout" Grid.Row="2" ColumnSpacing="22" RowSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <Border x:Name="PreviewArea" Grid.Column="0" Style="{StaticResource CardBorderStyle}" MinHeight="560">
                    <Grid RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="작업 미리보기" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="원본과 실제로 그려질 결과를 비교하세요." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="원본  →  변환 결과" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="PreviewColumns" Grid.Row="1" ColumnSpacing="14" MinHeight="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="0" />
                            </Grid.RowDefinitions>

                            <Border x:Name="OriginalCard" Grid.Column="0" Background="{StaticResource SoftPanelBrush}" CornerRadius="12" Padding="14">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="원본 이미지" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ImageName, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Background="#FFFFFF" CornerRadius="9" MinHeight="350">
                                        <Image Source="{x:Bind ViewModel.OriginalImageSource, Mode=OneWay}" Stretch="Uniform" Margin="14" />
                                        <StackPanel Visibility="{x:Bind ViewModel.WelcomeVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="280">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="34" Foreground="#98A2B3" HorizontalAlignment="Center" />
                                            <TextBlock Text="이미지를 선택해 주세요" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="PNG · JPG · WEBP · BMP" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
                                            <TextBlock Text="파일을 선택하거나 이 영역으로 끌어오세요" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                                            <TextBlock Text="첫 테스트는 단순한 작은 그림을 권장합니다." Style="{StaticResource MutedTextStyle}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="ProcessedCard" Grid.Column="1" Background="{StaticResource SoftPanelBrush}" CornerRadius="12" Padding="14">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="변환 미리보기" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="프로필·색상·정확도 설정 반영" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" Background="#FFFFFF" CornerRadius="9" MinHeight="350">
                                        <Image Source="{x:Bind ViewModel.ProcessedImageSource, Mode=OneWay}" Stretch="Uniform" Margin="14" />
                                        <StackPanel Visibility="{x:Bind ViewModel.WelcomeVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="280">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="30" Foreground="#98A2B3" HorizontalAlignment="Center" />
                                            <TextBlock Text="아직 변환 결과가 없습니다" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                                            <TextBlock Text="이미지와 프로필을 준비하면 실제 그리기 결과가 표시됩니다." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="이미지 선택" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SelectImageCommand}" />
                            <TextBlock Grid.Column="1" Text="지원 형식: PNG / JPG / WEBP / BMP · 드래그 앤 드롭 가능" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel x:Name="ControlRail" Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.OnboardingVisibility, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="처음 사용하시나요?" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="아래 순서대로 진행하면 됩니다. 작은 이미지로 먼저 안전하게 확인해 보세요." Style="{StaticResource MutedTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="이미지 선택" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.SelectImageCommand}" />
                                <Button Content="새 프로필" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.CreateDefaultProfileCommand}" />
                                <Button Content="도움말" Style="{StaticResource TextButtonStyle}" Click="Help_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="작업 순서" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="현재 필요한 단계가 파란색으로 표시됩니다." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <ListView
                                ItemsSource="{x:Bind ViewModel.WorkflowSteps}"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                BorderThickness="0"
                                Padding="0"
                                Background="Transparent">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:WorkflowStepViewModel">
                                        <Grid ColumnSpacing="10" Padding="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{x:Bind BadgeBackground}" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind Number}" Foreground="{x:Bind StateBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind StateText}" Foreground="{x:Bind StateBrush}" FontSize="12" HorizontalAlignment="Right" />
                                                <Button Content="{x:Bind ActionLabel}" Style="{StaticResource TextButtonStyle}" Command="{x:Bind ActionCommand}" Visibility="{x:Bind ActionVisibility}" Padding="8,3" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="게임 프로필" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ProfileSummary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="새 프로필" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.CreateDefaultProfileCommand}" />
                            </Grid>
                            <ComboBox
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Profiles}"
                                DisplayMemberPath="Name"
                                SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                PlaceholderText="프로필을 선택하세요" />
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="캔버스 위치 설정" Command="{x:Bind ViewModel.CalibrateCanvasCommand}" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}" />
                                <Button Grid.Column="1" Content="색상 위치 설정" Click="CalibrateAdapter_Click" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}" />
                                <Button Grid.Column="2" Content="편집" Style="{StaticResource TextButtonStyle}" Click="ConfigureProfile_Click" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}" />
                                <Button Grid.Column="3" Content="삭제" Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.DeleteSelectedProfileCommand}" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="13">
                            <StackPanel Spacing="3">
                                <TextBlock Text="그리기 설정" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="변환 결과와 입력 속도에 영향을 줍니다." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="그리기 방식" Style="{StaticResource EyebrowTextStyle}" />
                                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedDrawingModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="연속 선 (Scanline)" />
                                        <ComboBoxItem Content="픽셀 단위 (Pixel)" />
                                        <ComboBoxItem Content="선화 (Line Art)" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="색상 방식" Style="{StaticResource EyebrowTextStyle}" />
                                    <ComboBox x:Name="ColorAdapterComboBox" SelectedIndex="{x:Bind ViewModel.SelectedColorAdapterIndex, Mode=TwoWay}" SelectionChanged="ColorAdapter_SelectionChanged" IsEnabled="{x:Bind ViewModel.HasSelectedProfile, Mode=OneWay}">
                                        <ComboBoxItem Content="수동 색상 선택" />
                                        <ComboBoxItem Content="HEX 입력" />
                                        <ComboBoxItem Content="고정 팔레트" />
                                        <ComboBoxItem Content="HSV 선택기" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Text="사용 색상 수" Style="{StaticResource EyebrowTextStyle}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.ColorCounts}" SelectedItem="{x:Bind ViewModel.ColorCount, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="그림 정확도" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Precision, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                                <TextBlock Text="높일수록 더 세밀해지고 처리 시간이 늘어날 수 있습니다." Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                <Slider Minimum="0.2" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.Precision, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Text="그리기 속도" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.Speed, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                                <TextBlock Text="빠를수록 짧게 걸리지만 너무 빠르면 선이 끊길 수 있습니다." Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                <Slider Minimum="0.2" Maximum="1" StepFrequency="0.05" Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="시작 전 확인" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="준비가 완료되면 사전 점검을 먼저 실행하세요." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource SoftPanelBrush}" CornerRadius="9" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="변환 통계" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.StatisticsText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource SoftPanelBrush}" CornerRadius="9" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="예상 시간" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.EstimatedTimeText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Background="{StaticResource SoftPanelBrush}" CornerRadius="9" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="그리기 방식" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedModeText, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SoftPanelBrush}" CornerRadius="9" Padding="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="색상 방식" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.AdapterSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="9" Padding="12">
                                <TextBlock Text="{x:Bind ViewModel.StartAvailabilityText, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.DryRunText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="사전 점검" Command="{x:Bind ViewModel.DryRunCommand}" IsEnabled="{x:Bind ViewModel.CanDryRun, Mode=OneWay}" />
                                <Button Grid.Column="1" Content="자동 그리기 시작" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartDrawingCommand}" IsEnabled="{x:Bind ViewModel.CanStartDrawing, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasImageVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" MinWidth="38" />
                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="진행 상황" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Maximum="1" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="현재 색상" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentColorText, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Text="· F7 일시정지/다시 시작 · F8 긴급 중지" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="일시정지 / 다시 시작" Command="{x:Bind ViewModel.TogglePauseCommand}" IsEnabled="{x:Bind ViewModel.IsDrawing, Mode=OneWay}" />
                        <Button Content="중지" Style="{StaticResource TextButtonStyle}" Command="{x:Bind ViewModel.StopDrawingCommand}" IsEnabled="{x:Bind ViewModel.IsDrawing, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Text="F7 일시정지 / 다시 시작    ·    F8 긴급 중지    ·    실제 게임은 작은 이미지로 먼저 확인하세요" HorizontalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextAlignment="Center" />
        </Grid>
    </ScrollViewer>
</Page>
